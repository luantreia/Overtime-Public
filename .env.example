# Copiá este archivo a .env / .env.production y completá los valores.

# Reporte de errores. Sin esto, el SDK ni se inicializa: dejalo vacío en desarrollo.
# El DSN de Sentry es público por diseño (viaja en el bundle), no es un secreto.
REACT_APP_SENTRY_DSN=

# Overtime-Manager. Se usa para redirigir las invitaciones viejas (/claim/:token) hacia donde
# vive ahora el canje. Sin esto, esos links muestran un cartel en vez de continuar.
REACT_APP_MANAGER_URL=
